<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Hipcall.Sdk.Deneme</PackageId>
    <RootNamespace>Hipcall.Sdk.Deneme</RootNamespace>
    <AssemblyName>Hipcall.Sdk.Deneme</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Abdulvahap Fansa, Hipcall</Authors>
    <Company>Hipcall</Company>
    <Description>Hipcall API'leri ile entegrasyon sağlamak için resmi C# .NET 8 SDK'si. OAuth2 desteği ve tüm REST API endpointlerini içerir.</Description>
    <PackageProjectUrl>https://github.com/Fabsava/hipcall-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Fabsava/hipcall-sdk-dotnet</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>hipcall;sdk;api;rest;telephony;csharp;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Form" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Multipart" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Text" Version="2.1.2" />
  </ItemGroup>

</Project>
